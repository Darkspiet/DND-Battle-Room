[Unit]
Description=DND Battle Room
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=dnd-battle-room
Group=dnd-battle-room
WorkingDirectory=/opt/dnd-battle-room
Environment=NODE_ENV=production
Environment=DND_CONFIG_FILE=/etc/dnd-battle-room/config.json
ExecStart=/opt/dnd-battle-room-node/bin/node server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
