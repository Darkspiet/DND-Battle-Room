{
  "name": "dnd-battle-room",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server.mjs",
    "build": "next build",
    "start": "node server.mjs",
    "lint": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test",
    "db:apply": "node --env-file-if-exists=.env.local scripts/apply-db-schema.mjs",
    "install:production": "bash scripts/install-production.sh",
    "verify": "npm run typecheck && npm run test:e2e && npm run build",
    "deploy:restart": "systemctl restart dnd-battle-room",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "bootstrap:dm": "node scripts/bootstrap-dm.mjs",
    "test:installer": "node --test tests/installer/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs"
  },
  "dependencies": {
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  },
  "overrides": {
    "postcss": "8.5.31",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "MIT"
}
