{
  "name": "dnd-battle-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build && tsup server.ts --format esm --platform node --target node24 --out-dir dist --clean --external next --external @next/env --external ./scripts/load-config.mjs",
    "start": "node server.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:local": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100 playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/apply-db-schema.mjs",
    "db:studio": "drizzle-kit studio",
    "install:production": "bash scripts/install-production.sh",
    "verify": "npm run lint && npm run typecheck && npm run test:e2e && npm run build && npm run test && npm run test:installer",
    "deploy:restart": "systemctl restart dnd-battle-room",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "db:apply": "node scripts/apply-db-schema.mjs",
    "test:installer": "node --test tests/installer/*.test.mjs"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@next/env": "^16.2.11",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-tabs": "^1.1.18",
    "@xyflow/react": "^12.11.2",
    "drizzle-orm": "^0.45.2",
    "konva": "^10.3.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "mathjs": "15.2.0",
    "postcss": "8.5.31",
    "sharp": "0.35.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  }
}
