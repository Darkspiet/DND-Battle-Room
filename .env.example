# PostgreSQL is required in production, development and tests.
DATABASE_URL=postgresql://dnd_battle_room:change-me@127.0.0.1:5432/dnd_battle_room
SITE_NAME=DND Battle Room
# Exact browser origin, also used for cookie and HTTP/Socket.IO security.
APP_URL=http://127.0.0.1:3000
HOSTNAME=127.0.0.1
PORT=3000
# Use /var/lib/dnd-battle-room/assets in production; the installer creates it.
ASSET_DIR=.data/assets
LOG_LEVEL=info
# Production systemd loads protected JSON using DND_CONFIG_FILE instead of this file.
