# Manual development: copy to .env.local; use port 3100.
# Installer production config is /etc/dnd-battle-room/config.json, not this file.
DATABASE_URL=postgresql://dnd_battle_room:CHANGE_ME@127.0.0.1:5432/dnd_battle_room
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
SITE_NAME="DND Battle Room"
APP_URL=http://127.0.0.1:3100
HOSTNAME=127.0.0.1
PORT=3100
